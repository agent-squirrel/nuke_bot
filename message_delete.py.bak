#!/usr/bin/env python3
import logging
from buttons import nuke_controls, exterminatus_controls
import time
import discord
import aiohttp
import datetime
from discord.ext import commands, tasks
import yaml
from zoneinfo import ZoneInfo
import random

with open ('config.yaml', 'r') as f:
    config = yaml.safe_load(f)

discord_token = config['discord']['token']
guilds = config['discord']['guilds']
bot = discord.Bot()

TARGET_WORD = "holly"  # Word to search for

# Set up the bot
intents = discord.Intents.default()
intents.messages = True
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"Logged in as {bot.user}")

@bot.command()
async def clean_surrounding(ctx, channel: discord.TextChannel):
    """Find all instances of a word in a channel and delete messages around them."""
    try:
        async for message in channel.history(limit=None):
            if TARGET_WORD.lower() in message.content.lower():
                # Collect messages to delete (5 before and 5 after the target message)
                messages_to_delete = []

                # Fetch messages before
                async for before_message in channel.history(limit=5, before=message):
                    messages_to_delete.append(before_message)

                # Add the target message
                messages_to_delete.append(message)

                # Fetch messages after
                async for after_message in channel.history(limit=5, after=message):
                    messages_to_delete.append(after_message)

                # Delete messages one by one to handle messages older than 14 days
                for msg in messages_to_delete:
                    try:
                        await msg.delete()
                    except discord.HTTPException as e:
                        print(f"Failed to delete message: {e}")

                print(f"Deleted messages around: {message.content}")
        print("Done!")

    except discord.Forbidden:
        await ctx.send("I don't have permission to delete messages in this channel.")
    except discord.HTTPException as e:
        await ctx.send(f"An error occurred: {e}")

# Run the bot
bot.run(discord_token)
