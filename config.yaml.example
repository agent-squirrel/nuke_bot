---
discord:
  token:
  accepted_channels:
    - channelid
    - secondchannelid

  guilds:
    - guildid
    - secondguildid

  presence_msg: 'Some presence message'

  # IANA timezone name the delete and warning times are in
  timezone: 'Australia/Hobart'
  # Automatically nuke accepted channels daily at channel_delete_time
  auto_nuke: false

  # 24 hour notation
  channel_warning_time: '09:55'
  channel_delete_time: '10:00'

gifs:
  exterminatus:
    - "assets/images/exterminatus1.gif"
    - "assets/images/exterminatus2.gif"
    - "assets/images/exterminatus3.gif"
  nuke:
    - "assets/images/nuke1.gif"
    - "assets/images/nuke2.gif"
    - "assets/images/nuke3.gif"
  spice:
    - "assets/images/spice1.gif"
    - "assets/images/spice2.gif"
    - "assets/images/spice3.gif"
  helen:
    - "assets/images/india1.gif"
    - "assets/images/india2.gif"
    - "assets/images/india3.gif"
    - "assets/images/india4.gif"

# Extra gif posted after a nuke completes, channel id: gif set from above
post_nuke_gifs:
  channelid: spice
  secondchannelid: helen

monitoring:
  endpoint: 'https://someendpoint.com'

logging:
  level: WARNING
